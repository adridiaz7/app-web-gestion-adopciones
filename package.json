{
  "name": "lagun-app-adopciones",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server/server.ts",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "start": "node --env-file=.env dist/server/server.js",
    "pretest": "node scripts/test-lock.ts check",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json --noEmit",
    "db:reset": "node --env-file=.env scripts/db-reset.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
