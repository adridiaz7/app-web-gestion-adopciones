# Copy to .env and adjust. .env is gitignored.
# No password in the URL: pg and psql read it from %APPDATA%\postgresql\pgpass.conf.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres@localhost:5432/lagun
# Public URL used in the links of the emails. Defaults to http://localhost:<PORT>.
# APP_URL=http://localhost:3000
# Folder for the uploaded photos (gitignored). Defaults to uploads/ in the project root.
# UPLOADS_DIR=uploads
# Maximum size of one photo, in MB (JPEG, PNG or WebP).
# MAX_PHOTO_SIZE_MB=5

# Tests (npm test) do not read this file. They use TEST_DATABASE_URL from the shell, or
# postgres://postgres@localhost:5432/lagun_test by default. The name must end in _test:
# every run drops and recreates it from db/schema.sql (created automatically if missing).

# Configurable parameters (docs/reglas-de-negocio.md §16). Every one has a default
# in src/server/config.ts; uncomment a line only to override it.
# VISIT_MIN_NOTICE_HOURS=48               # RN-87
# VISIT_RESPONSE_DEADLINE_HOURS=24        # RN-94
# VISIT_CANCEL_MIN_NOTICE_HOURS=24        # RN-97
# VISIT_AUTO_COMPLETE_HOURS=48            # RN-106
# VISIT_QUOTA_PER_SHELTER=3               # RN-90
# VISIT_QUOTA_WINDOW_MONTHS=3             # RN-90
# ADOPTION_REMINDER_INTERVAL_DAYS=3       # RN-122
# VISIT_VALIDITY_FOR_ADOPTION_MONTHS=1    # RN-116
# HANDOVER_REMINDER_INTERVAL_DAYS=1       # RN-127
# ADOPTION_COMPLETION_DEADLINE_DAYS=5     # RN-128
# DISCARD_DURATION_DAYS=15                # RN-75
# FIRST_BLOCK_DURATION_DAYS=15            # RN-201
# VISIT_REMINDER_NOTICE_HOURS=48          # RN-197
# RECURRING_SLOTS_MAX_RANGE_MONTHS=3      # RN-192
# MAX_PHOTOS_PER_PET=6                    # RN-50
# SESSION_DURATION_DAYS=30                # RN-176
# SESSION_RENEWAL_MARGIN_DAYS=15          # RN-176
# EMAIL_VERIFICATION_VALIDITY_HOURS=24    # RN-177
# PASSWORD_RESET_VALIDITY_MINUTES=30      # RN-178
# LOGIN_MAX_ATTEMPTS=10                   # RN-179
# LOGIN_ATTEMPTS_WINDOW_MINUTES=15        # RN-179
# VERIFICATION_RESEND_WAIT_MINUTES=5      # RN-180
# PASSWORD_RESET_RESEND_WAIT_MINUTES=5    # RN-181
# EXISTING_ACCOUNT_NOTICE_WAIT_MINUTES=5  # RN-182
